{
  "realm": "deepsecure",
  "enabled": true,
  "displayName": "DeepSecure",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "accessTokenLifespanForImplicitFlow": 900,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Basic user access",
        "composite": false
      },
      {
        "name": "admin",
        "description": "Administrative access",
        "composite": true,
        "composites": {
          "realm": ["user"]
        }
      },
      {
        "name": "engineer",
        "description": "Engineering team access",
        "composite": false
      },
      {
        "name": "sales",
        "description": "Sales team access",
        "composite": false
      }
    ]
  },
  "groups": [
    {
      "name": "engineering",
      "path": "/engineering",
      "realmRoles": ["user", "engineer"]
    },
    {
      "name": "sales",
      "path": "/sales",
      "realmRoles": ["user", "sales"]
    },
    {
      "name": "platform-team",
      "path": "/platform-team",
      "realmRoles": ["user", "engineer"]
    }
  ],
  "defaultRoles": ["user"],
  "clients": [
    {
      "clientId": "deepsecure-control",
      "name": "DeepSecure Control Plane",
      "description": "Control Plane OIDC client for user authentication",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "control-secret",
      "redirectUris": [
        "http://localhost:8000/api/v1/auth/sso/*/callback",
        "http://localhost:8000/*",
        "http://localhost:3000/api/auth/sso/*/callback",
        "http://localhost:3000/*",
        "https://localhost:8443/api/v1/auth/sso/*/callback",
        "https://localhost:8443/*",
        "https://app.deepsecure.one/api/v1/auth/sso/*/callback",
        "https://app.deepsecure.one/*"
      ],
      "webOrigins": [
        "http://localhost:8000",
        "http://localhost:3000",
        "https://localhost:8443",
        "https://app.deepsecure.one"
      ],
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "group-membership",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "groups",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "gateway",
      "name": "DeepSecure Gateway",
      "description": "Gateway client for token exchange (RFC 8693) — used by WS-J6",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "gateway-secret",
      "redirectUris": [],
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "openid",
        "profile",
        "email"
      ],
      "attributes": {
        "oidc.token.exchange.enabled": "true"
      }
    }
  ],
  "users": [
    {
      "username": "mahendra@deeptrail.com",
      "email": "mahendra@deeptrail.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Mahendra",
      "lastName": "Kutare",
      "groups": [
        "/engineering",
        "/platform-team"
      ],
      "realmRoles": [
        "user",
        "admin",
        "engineer"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "test_password",
          "temporary": false
        }
      ]
    },
    {
      "username": "sarah@deeptrail.com",
      "email": "sarah@deeptrail.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Sarah",
      "lastName": "Chen",
      "groups": [
        "/sales"
      ],
      "realmRoles": [
        "user",
        "sales"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "test_password",
          "temporary": false
        }
      ]
    }
  ],
  "scopeMappings": [
    {
      "client": "deepsecure-control",
      "roles": ["user"]
    }
  ],
  "clientScopeMappings": {
    "gateway": [
      {
        "client": "gateway",
        "roles": ["user"]
      }
    ]
  }
}
