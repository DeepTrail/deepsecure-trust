# Service OAuth credentials — copy to .env.services and fill in real values.
# Loaded by docker-compose.yml via env_file (same pattern as .env.google).
#
# See docs/design/secrets-architecture.md for how these work in production.

# Notion OAuth (https://www.notion.so/my-integrations → your integration → OAuth)
NOTION_CLIENT_ID=<your-notion-client-id>
NOTION_CLIENT_SECRET=<your-notion-client-secret>

# Slack OAuth (https://api.slack.com/apps → your app → OAuth & Permissions)
SLACK_CLIENT_ID=<your-slack-client-id>
SLACK_CLIENT_SECRET=<your-slack-client-secret>
